# Database
DATABASE_URL="postgresql://usuario:password@localhost:5432/geofence_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# App
PORT=3000
NODE_ENV="development"

# Firebase Cloud Messaging (FCM) - opcional para notificaciones push
FCM_SERVER_KEY="your-fcm-server-key"
